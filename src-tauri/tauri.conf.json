{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "COLECCION DISCOGRAFICA",
  "version": "1.0.0",
  "identifier": "com.hsystem.discografica",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "COLECCION DISCOGRAFICA",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
